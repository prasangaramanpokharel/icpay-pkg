{
  "name": "prasangapokharel/icpay-bucket",
  "description": "ICPay Bucket client — on-chain cloud file storage SDK for PHP",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Prasanga Pokharel",
      "homepage": "https://icpay.app"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "ICPay\\Bucket\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ICPay\\Bucket\\Tests\\": "tests/"
    }
  }
}
